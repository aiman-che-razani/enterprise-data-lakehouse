{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://retailnexus.com/schemas/orders/v1",
  "title": "Order",
  "description": "Retail order header including customer, channel, financials, and fulfillment status",
  "type": "object",
  "required": [
    "order_id", "customer_id", "order_date", "channel", "status",
    "payment_status", "subtotal", "total_amount", "currency", "created_at"
  ],
  "properties": {
    "order_id":         { "type": "string", "pattern": "^ORD-[0-9]{10}$" },
    "customer_id":      { "type": "string", "pattern": "^CUST-[0-9]{8}$" },
    "order_date":       { "type": "string", "format": "date" },
    "channel":          { "type": "string", "enum": ["web", "mobile_app", "store", "phone"] },
    "store_id":         { "type": ["string", "null"] },
    "status":           { "type": "string", "enum": ["confirmed", "processing", "shipped", "delivered", "cancelled", "returned"] },
    "payment_status":   { "type": "string", "enum": ["pending", "paid", "failed", "partially_refunded", "refunded"] },
    "subtotal":         { "type": "number", "minimum": 0 },
    "discount_amount":  { "type": "number", "minimum": 0 },
    "tax_amount":       { "type": "number", "minimum": 0 },
    "shipping_amount":  { "type": "number", "minimum": 0 },
    "total_amount":     { "type": "number", "minimum": 0 },
    "currency":         { "type": "string", "enum": ["USD", "CAD", "GBP", "EUR", "AUD"] },
    "promo_code":       { "type": ["string", "null"] },
    "is_gift":          { "type": "boolean" },
    "created_at":       { "type": "string", "format": "date-time" },
    "updated_at":       { "type": "string", "format": "date-time" },
    "source_system":    { "type": "string" }
  },
  "additionalProperties": false
}
