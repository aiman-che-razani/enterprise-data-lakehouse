{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://retailnexus.com/schemas/campaigns/v1",
  "title": "MarketingCampaign",
  "description": "Marketing campaign with budget, performance metrics, and channel attribution",
  "type": "object",
  "required": ["campaign_id", "campaign_name", "campaign_type", "objective", "platform", "budget", "start_date", "created_at"],
  "properties": {
    "campaign_id":        { "type": "string", "pattern": "^CAM-[0-9]{7}$" },
    "campaign_name":      { "type": "string" },
    "campaign_type":      { "type": "string", "enum": ["email", "paid_search", "social_media", "display", "affiliate", "sms", "push_notification"] },
    "objective":          { "type": "string", "enum": ["awareness", "acquisition", "retention", "win_back", "upsell"] },
    "platform":           { "type": "string" },
    "target_category":    { "type": "string" },
    "target_segment":     { "type": "string" },
    "budget":             { "type": "number", "minimum": 0 },
    "actual_spend":       { "type": "number", "minimum": 0 },
    "impressions":        { "type": "integer", "minimum": 0 },
    "clicks":             { "type": "integer", "minimum": 0 },
    "ctr":                { "type": "number", "minimum": 0 },
    "conversions":        { "type": "integer", "minimum": 0 },
    "conversion_rate":    { "type": "number", "minimum": 0 },
    "total_revenue":      { "type": "number", "minimum": 0 },
    "roas":               { "type": "number" },
    "cpc":                { "type": "number", "minimum": 0 },
    "cpa":                { "type": "number", "minimum": 0 },
    "is_active":          { "type": "boolean" },
    "start_date":         { "type": "string", "format": "date-time" },
    "end_date":           { "type": "string", "format": "date-time" },
    "created_at":         { "type": "string", "format": "date-time" },
    "updated_at":         { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
