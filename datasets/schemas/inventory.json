{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://retailnexus.com/schemas/inventory/v1",
  "title": "InventorySnapshot",
  "description": "Point-in-time inventory snapshot for a SKU at a store location",
  "type": "object",
  "required": [
    "inventory_id", "sku", "store_id", "snapshot_date",
    "quantity_on_hand", "quantity_available", "created_at"
  ],
  "properties": {
    "inventory_id":           { "type": "string" },
    "sku":                    { "type": "string" },
    "store_id":               { "type": "string" },
    "snapshot_date":          { "type": "string", "format": "date" },
    "abc_class":              { "type": "string", "enum": ["A", "B", "C"] },
    "quantity_on_hand":       { "type": "integer", "minimum": 0 },
    "quantity_reserved":      { "type": "integer", "minimum": 0 },
    "quantity_available":     { "type": "integer", "minimum": 0 },
    "quantity_on_order":      { "type": "integer", "minimum": 0 },
    "reorder_point":          { "type": "integer", "minimum": 0 },
    "reorder_quantity":       { "type": "integer", "minimum": 0 },
    "days_of_supply":         { "type": "number", "minimum": 0 },
    "cost_per_unit":          { "type": "number", "minimum": 0 },
    "total_inventory_value":  { "type": "number", "minimum": 0 },
    "bin_location":           { "type": "string" },
    "is_below_reorder_point": { "type": "boolean" },
    "is_out_of_stock":        { "type": "boolean" },
    "last_received_date":     { "type": "string", "format": "date" },
    "last_count_date":        { "type": "string", "format": "date" },
    "created_at":             { "type": "string", "format": "date-time" },
    "updated_at":             { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
