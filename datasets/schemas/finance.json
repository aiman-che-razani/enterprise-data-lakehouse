{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://retailnexus.com/schemas/finance/v1",
  "title": "FinanceTransaction",
  "description": "General ledger double-entry bookkeeping transaction",
  "type": "object",
  "required": [
    "transaction_id", "journal_entry_id", "transaction_type",
    "debit_account_code", "credit_account_code",
    "debit_amount", "credit_amount", "transaction_date", "created_at"
  ],
  "properties": {
    "transaction_id":       { "type": "string", "pattern": "^TXN-[0-9]{10}$" },
    "journal_entry_id":     { "type": "string", "pattern": "^JE-[0-9]{10}$" },
    "transaction_type":     { "type": "string" },
    "debit_account_code":   { "type": "string" },
    "debit_account_name":   { "type": "string" },
    "credit_account_code":  { "type": "string" },
    "credit_account_name":  { "type": "string" },
    "debit_amount":         { "type": "number", "minimum": 0 },
    "credit_amount":        { "type": "number", "minimum": 0 },
    "description":          { "type": "string" },
    "reference_id":         { "type": ["string", "null"] },
    "cost_center":          { "type": "string" },
    "fiscal_year":          { "type": "integer" },
    "fiscal_period":        { "type": "integer", "minimum": 1, "maximum": 12 },
    "fiscal_quarter":       { "type": "integer", "minimum": 1, "maximum": 4 },
    "transaction_date":     { "type": "string", "format": "date" },
    "posted_at":            { "type": "string", "format": "date-time" },
    "source_system":        { "type": "string" },
    "is_reconciled":        { "type": "boolean" },
    "is_reversed":          { "type": "boolean" },
    "created_at":           { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
