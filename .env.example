# ═══════════════════════════════════════════════════════════════════════════════
# RetailNexus Data Lakehouse — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=dev
# Options: dev | staging | prod

# ─── MinIO (local S3 emulation) ───────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_CONSOLE_PORT=9001
LAKEHOUSE_BUCKET=retailnexus-lakehouse

# ─── AWS (used in staging/prod instead of MinIO) ─────────────────────────────
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
# AWS_S3_ENDPOINT_URL=  # Omit in prod; set to MinIO URL in dev

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=lakehouse
POSTGRES_PASSWORD=lakehouse
POSTGRES_DB=lakehouse

# ─── Airflow ──────────────────────────────────────────────────────────────────
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=airflow
AIRFLOW_POSTGRES_DB=airflow

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=REPLACE_WITH_GENERATED_SECRET_KEY

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User
AIRFLOW_ADMIN_EMAIL=admin@retailnexus.com

# ─── Apache Kafka ─────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_AUTO_CREATE_TOPICS=false
KAFKA_REPLICATION_FACTOR=1

# ─── Apache Spark ─────────────────────────────────────────────────────────────
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_MEMORY=4g
SPARK_WORKER_CORES=2
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g

# ─── FastAPI ──────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_SECRET_KEY=REPLACE_WITH_GENERATED_SECRET_KEY
# Sustained requests per minute per API key (0 disables the limiter, e.g. for load tests)
API_RATE_LIMIT_PER_MINUTE=300
API_DEBUG=true

# ─── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ─── Elasticsearch ────────────────────────────────────────────────────────────
ELASTIC_VERSION=8.13.4
ELASTIC_PASSWORD=elastic
ELASTICSEARCH_HOSTS=http://elasticsearch:9200

# ─── Monitoring ───────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ─── Notifications (optional) ─────────────────────────────────────────────────
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# PAGERDUTY_ROUTING_KEY=YOUR_PAGERDUTY_KEY

# ─── Secrets Manager (staging/prod only) ─────────────────────────────────────
# SECRETS_BACKEND=aws_secrets_manager
# AWS_SECRETS_MANAGER_PREFIX=/retailnexus/lakehouse/
